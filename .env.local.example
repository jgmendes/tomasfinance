# Supabase — copie este arquivo para .env.local e preencha
# Settings > API no painel do Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-publishable-ou-anon-key

# (Opcional) CFO Virtual com IA real (Google Gemini — console.cloud.google.com / aistudio.google.com)
GEMINI_API_KEY=

# ============ COBRANÇA (SaaS) — somente servidor ============
# Service role do Supabase (NUNCA exponha no client). Usada pelo webhook.
SUPABASE_SERVICE_ROLE_KEY=

# Bravive Banking (somente servidor)
BRAVIVE_API_URL=https://api.bravive.com
BRAVIVE_CLIENT_ID=
BRAVIVE_SECRET=
# Mesmo segredo configurado no painel da Bravive (X-Webhook-Secret)
BRAVIVE_WEBHOOK_SECRET=
