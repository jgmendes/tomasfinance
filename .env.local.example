# Supabase — copie este arquivo para .env.local e preencha com os dados do seu projeto
# Settings > API no painel do Supabase

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# (Opcional) usada apenas no servidor para tarefas administrativas. NUNCA exponha no client.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# (Opcional) Para o CFO Virtual com IA real (Anthropic Claude). Sem isso, usamos análise local por regras.
ANTHROPIC_API_KEY=
